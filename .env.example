# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# MSG91 (SMS OTP & order notifications)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_ORDER_TEMPLATE_ID=your-order-template-id

# Email notifications (optional)
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=orders@sabarikrishna.in

# AI Chatbot (optional - uses OpenAI-compatible API)
OPENAI_API_KEY=sk-xxxxx

# Marketplace sync (optional)
AMAZON_SP_API_KEY=
FLIPKART_API_KEY=
